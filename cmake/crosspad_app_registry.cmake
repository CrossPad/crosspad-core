# Generates app_registry_init.cpp: AppRegistry_InitAll() calls every
# _register_<Name>_app() function the scanned sources define. REGISTER_APP and
# REGISTER_APP_PL create those functions; static registrar objects are not
# reliable on ESP-IDF, so nothing registers itself.
#
# Shared by every CMake-based platform (ESP-IDF firmware, PC simulator) so the
# two discover apps the same way.
#
#   crosspad_generate_app_registry(
#       OUTPUT  <path to generated .cpp>
#       FILES   <.cpp files>       # scanned first, in this order
#       DIRS    <dirs>             # then each dir's *.cpp, recursively, sorted
#       EXCLUDE <dir names>        # skip sources under a directory of this name
#   )
#
# A source names an app by
#   REGISTER_APP(Name, ...)
#   REGISTER_APP_PL(Name, ...)
#   void _register_Name_app()
# Apps are registered in the order they are first found.

function(_crosspad_registry_scan_file names_var src)
    set(_names ${${names_var}})
    file(READ "${src}" _content)

    string(REGEX MATCHALL "REGISTER_APP\\(([^,]+)," _matches "${_content}")
    foreach(_m ${_matches})
        string(REGEX REPLACE "REGISTER_APP\\(([^,]+)," "\\1" _name "${_m}")
        string(STRIP "${_name}" _name)
        list(APPEND _names "${_name}")
    endforeach()

    # Matched separately so the capture-group index of the plain form above
    # stays put. Without it an app that declares pad logic compiles and links
    # but never registers, so it never appears in the launcher.
    string(REGEX MATCHALL "REGISTER_APP_PL\\(([^,]+)," _matches "${_content}")
    foreach(_m ${_matches})
        string(REGEX REPLACE "REGISTER_APP_PL\\(([^,]+)," "\\1" _name "${_m}")
        string(STRIP "${_name}" _name)
        list(APPEND _names "${_name}")
    endforeach()

    string(REGEX MATCHALL "void _register_([A-Za-z0-9_]+)_app\\(" _matches "${_content}")
    foreach(_m ${_matches})
        string(REGEX REPLACE "void _register_([A-Za-z0-9_]+)_app\\(" "\\1" _name "${_m}")
        list(APPEND _names "${_name}")
    endforeach()

    set(${names_var} ${_names} PARENT_SCOPE)
endfunction()

function(crosspad_generate_app_registry)
    cmake_parse_arguments(ARG "" "OUTPUT" "FILES;DIRS;EXCLUDE" ${ARGN})

    set(_sources "")
    foreach(_src ${ARG_FILES})
        if(EXISTS "${_src}")
            list(APPEND _sources "${_src}")
        endif()
    endforeach()
    foreach(_dir ${ARG_DIRS})
        if(EXISTS "${_dir}")
            file(GLOB_RECURSE _found "${_dir}/*.cpp")
            list(APPEND _sources ${_found})
        endif()
    endforeach()

    set(_names "")
    foreach(_src ${_sources})
        set(_skip FALSE)
        foreach(_excl ${ARG_EXCLUDE})
            if("${_src}" MATCHES "/${_excl}/")
                set(_skip TRUE)
            endif()
        endforeach()
        if(NOT _skip)
            _crosspad_registry_scan_file(_names "${_src}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _names)

    set(_text "// Auto-generated file - DO NOT EDIT\n")
    string(APPEND _text "// Generated by crosspad-core/cmake/crosspad_app_registry.cmake\n\n")
    foreach(_name ${_names})
        string(APPEND _text "extern void _register_${_name}_app();\n")
    endforeach()
    string(APPEND _text "\nvoid AppRegistry_InitAll() {\n")
    foreach(_name ${_names})
        string(APPEND _text "    _register_${_name}_app();\n")
    endforeach()
    string(APPEND _text "}\n")
    file(WRITE "${ARG_OUTPUT}" "${_text}")

    list(LENGTH _names _count)
    get_filename_component(_out_name "${ARG_OUTPUT}" NAME)
    message(STATUS "Generated ${_out_name} with ${_count} apps: ${_names}")
endfunction()
