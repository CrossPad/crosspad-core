{
    "name": "crosspad-core",
    "version": "0.1.0",
    "description": "CrossPad portable core library",
    "keywords": ["crosspad", "midi", "sampler", "embedded"],
    "frameworks": ["arduino", "espidf"],
    "platforms": ["espressif32", "native"],
    "build": {
        "srcDir": "src",
        "includeDir": "include",
        "flags": [],
        "srcFilter": [
            "-<*>",
            "+<event/EspEventBus.cpp>",
            "+<app/AppRegistry.cpp>",
            "+<pad/PadManager.cpp>",
            "+<pad/PadLedController.cpp>",
            "+<pad/PadAnimator.cpp>",
            "+<pad/RGBCallbackManager.cpp>",
            "+<settings/CrosspadSettings.cpp>",
            "+<protocol/Stm32CommandSender.cpp>",
            "+<protocol/Stm32MessageHandler.cpp>",
            "+<stm32/Stm32Manager.cpp>",
            "+<music/MusicTheory.cpp>",
            "+<midi/MidiInputHandler.cpp>",
            "+<platform/CrosspadPlatformInit.cpp>",
            "+<platform/PlatformCapabilities.cpp>",
            "+<platform/PlatformServices.cpp>",
            "+<kit/KitJsonParser.cpp>",
            "+<kit/PortableKitLoader.cpp>",
            "+<app/AppManagerBase.cpp>",
            "+<event/FreeRtosEventBus.cpp>",
            "+<event/SyncEventBus.cpp>",
            "+<settings/ISettingsUI.cpp>",
            "+<drivers/Drv2605Driver.cpp>"
        ]
    }
}
